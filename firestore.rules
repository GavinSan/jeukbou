rules_version = '2';

// 雀簿資料庫規則：預設乜都唔准，只開放牌友圈成員需要嘅讀寫。
// 網頁設定（apiKey 嗰啲）係公開嘅，真正保護資料嘅係呢份規則。
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function groupDoc(g) {
      return get(/databases/$(database)/documents/groups/$(g));
    }
    // 超級管理員：email 喺部署時由 GitHub Secret SUPER_ADMIN_EMAIL 填入（repo 入面只有佔位字）
    function isSuperAdmin() {
      return signedIn() && request.auth.token.email_verified == true
        && request.auth.token.email == '__SUPER_ADMIN_EMAIL__';
    }
    function isMember(g) {
      return isSuperAdmin() || (signedIn() && exists(/databases/$(database)/documents/groups/$(g)/members/$(request.auth.uid)));
    }
    function isOwner(g) {
      return isSuperAdmin() || (signedIn() && groupDoc(g).data.ownerId == request.auth.uid);
    }
    // 局主分配嘅權限：approve 批人入、remove 移除成員、records 管紀錄、rules 改家規
    function can(g, p) {
      return isOwner(g) || (signedIn() && p in get(/databases/$(database)/documents/groups/$(g)/members/$(request.auth.uid)).data.get('perms', []));
    }
    // 大局未埋數
    function isOpen(g, s) {
      return get(/databases/$(database)/documents/groups/$(g)/sessions/$(s)).data.get('closed', null) == null;
    }
    // 加入方式：auto 自動加入、approve 要局主批准、closed 不收新人（舊牌友圈冇設定 = auto）
    function joinMode(g) {
      return groupDoc(g).data.get('joinMode', 'auto');
    }
    // 頭像（細圖）大小上限
    function photoOk(d) {
      return d.get('photoURL', null) == null || (d.photoURL is string && d.photoURL.size() < 200000);
    }

    // 超級管理員：所有資料都讀得同改得（管理頁用）
    match /{document=**} {
      allow read, write: if isSuperAdmin();
    }

    // 用嚟俾 app 知自己係咪超級管理員：讀得到就係
    match /admin/{doc} {
      allow read: if isSuperAdmin();
      allow write: if false;
    }

    // 風格開放設定：登入咗嘅人都讀得；淨係超級管理員改得
    match /config/{doc} {
      allow read: if signedIn();
      allow write: if isSuperAdmin();
    }

    // 豪華風格授權：自己讀得自己嗰份；淨係超級管理員開／收（用家唔可以自己開）
    match /skinGrants/{uid} {
      allow read: if (signedIn() && request.auth.uid == uid) || isSuperAdmin();
      allow write: if isSuperAdmin();
    }

    // 玩家資料：淨係自己（同超級管理員）睇到同改到。其他人只會喺同一個牌友圈嘅成員名單見到你個名同頭像。
    match /users/{uid} {
      // 雀壇名：認領咗（有 nameKey）之後，每改一次 renames 要加 1（改名券）；nameKey 一定要係自己認領咗嘅 names/{key}
      function nameOk() {
        let before = resource == null ? {} : resource.data;
        let after = request.resource.data;
        let renamed = after.get('name', '') != before.get('name', '');
        return after.get('renames', 0) is int
          && after.get('renames', 0) >= before.get('renames', 0)
          && after.get('renames', 0) <= 40 + before.get('renameGrants', 0)
          && (!renamed || before.get('nameKey', null) == null || after.get('renames', 0) == before.get('renames', 0) + 1)
          && (after.get('nameKey', null) == null || after.get('nameKey', null) == before.get('nameKey', null)
            || getAfter(/databases/$(database)/documents/names/$(after.nameKey)).data.uid == request.auth.uid);
      }
      allow read: if (signedIn() && request.auth.uid == uid) || isSuperAdmin();
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'photoURL', 'avatar', 'updatedAt', 'groups', 'pending', 'payEmail', 'email', 'firstName', 'lastName', 'birthday', 'nudgedAt', 'nameKey', 'renames', 'renameGrants', 'payMethods'])
        && (resource == null || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['renameGrants']))
        && (resource != null || !('renameGrants' in request.resource.data))
        && nameOk()
        && (request.resource.data.get('payMethods', []) is list && request.resource.data.get('payMethods', []).size() <= 12)
        && (request.resource.data.get('avatar', null) == null || (request.resource.data.avatar is string && request.resource.data.avatar.size() < 200000));
      allow delete: if false;

      // 推播 token：每部機一個，淨係自己讀寫；伺服器用 admin 權限讀
      match /pushTokens/{t} {
        allow read, delete: if signedIn() && request.auth.uid == uid;
        allow create, update: if signedIn() && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['token', 'ua', 'at'])
          && request.resource.data.token is string && request.resource.data.token.size() < 1000;
      }
    }

    // 問題回報／建議：自己寫（可以附一張細相）；淨係超級管理員睇。
    // 防洗版：每次要同時更新 feedbackLast/{自己}，同上一次相隔最少 60 秒
    match /feedback/{f} {
      function fbLast() {
        return /databases/$(database)/documents/feedbackLast/$(request.auth.uid);
      }
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'name', 'email', 'text', 'image', 'page', 'ua', 'at', 'kind'])
        && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 2000
        && (request.resource.data.get('image', null) == null || (request.resource.data.image is string && request.resource.data.image.size() < 400000))
        && request.resource.data.at == request.time
        && getAfter(fbLast()).data.at == request.time
        && (!exists(fbLast()) || get(fbLast()).data.at < request.time - duration.value(60, 's'));
      allow read, update, delete: if false;
    }
    match /feedbackLast/{u} {
      allow read: if signedIn() && request.auth.uid == u;
      allow create, update: if signedIn() && request.auth.uid == u && request.resource.data.keys().hasOnly(['at']) && request.resource.data.at == request.time;
    }

    // 雀壇名：全 app 唯一。key = 細楷、去頭尾空白；知道個名先查到（唔可以列晒）；淨係自己認領、放返
    match /names/{key} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn() && key.size() <= 60 && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'name', 'at']);
      allow update: if signedIn() && resource.data.uid == request.auth.uid && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'name', 'at']);
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // 加入碼：知道個碼先讀到（唔可以列出所有碼）；淨係局主開或者刪
    match /codes/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn() && code.size() == 6 && isOwner(request.resource.data.g)
        && request.resource.data.invite == groupDoc(request.resource.data.g).data.inviteCode;
      allow update: if false;
      allow delete: if signedIn() && isOwner(resource.data.g);
    }

    // 公開牌友圈：登入咗嘅人都搜尋得到；局主寫
    match /publicGroups/{g} {
      allow read: if signedIn();
      allow write: if isOwner(g);
    }

    // 牌友圈
    match /groups/{g} {
      allow get: if isMember(g);
      allow list: if isSuperAdmin();
      // 打法：普通用家只開得港式台牌；其他打法試驗中，淨係超級管理員開得
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid
        && (request.resource.data.get('variant', 'hktw') == 'hktw' || isSuperAdmin());
      // 局主改晒；有「改家規」權限嘅成員只改得家規、番數表、埋數設定
      // 打法（牌型）開咗就唔改得（超級管理員除外）
      allow update: if (isOwner(g) || (can(g, 'rules')
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rules', 'fanTable', 'fanTableLog', 'settle'])))
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['variant', 'region']) || isSuperAdmin());
      // 刪除牌友圈：局主或者超級管理員（app 會先刪晒入面嘅大局同成員）
      allow delete: if isOwner(g);

      // 成員：局主加（包括批准申請），或者「自動加入」模式下自己用邀請碼加入
      match /members/{uid} {
        allow read: if isMember(g) || (signedIn() && request.auth.uid == uid);
        allow create: if photoOk(request.resource.data) && (can(g, 'approve') || (signedIn() && request.auth.uid == uid
          && request.resource.data.inviteCode == groupDoc(g).data.inviteCode
          && joinMode(g) == 'auto'));
        // 自己改自己個名同頭像，唔可以改邀請碼同自己嘅權限；局主淨係改得權限
        allow update: if (signedIn() && request.auth.uid == uid && photoOk(request.resource.data)
          && request.resource.data.inviteCode == resource.data.inviteCode
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['perms'])
          // 認領咗雀壇名之後：成員名一定要同 users 個名一樣（唔可以喺個別牌友圈偷偷改名）
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['name'])
            || get(/databases/$(database)/documents/users/$(uid)).data.get('nameKey', null) == null
            || request.resource.data.name == get(/databases/$(database)/documents/users/$(uid)).data.get('name', '')))
          || (isOwner(g) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['perms']));
        allow delete: if can(g, 'remove') || (signedIn() && request.auth.uid == uid);
      }

      // 預設 Group（每次埋數一齊計）：成員開；入面嘅人逐個同意；入面嘅人或者局主刪
      match /teams/{t} {
        allow read: if isMember(g);
        allow create: if isMember(g) && request.resource.data.by == request.auth.uid
          && request.resource.data.members is list
          && request.resource.data.members.size() >= 2 && request.resource.data.members.size() <= 8
          && (request.resource.data.accepted.hasOnly([request.auth.uid]) || isOwner(g));
        allow update: if isMember(g) && request.auth.uid in resource.data.members
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['accepted'])
          && request.resource.data.accepted.hasOnly(resource.data.members);
        allow delete: if isOwner(g) || (signedIn() && request.auth.uid in resource.data.members);
      }

      // 約局：成員開、應；約局嘅局主（開嗰個；佢唔去就由最早應「去」嗰個接手）或者牌友圈局主刪
      match /meetups/{m} {
        function meetHost(d) {
          return (d.by in d.going || d.going.size() == 0) ? d.by : d.going[0];
        }
        allow read: if isMember(g);
        allow create: if isMember(g) && request.resource.data.by == request.auth.uid;
        allow update: if isMember(g) && (resource.data.by == request.auth.uid
          || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['going', 'maybe', 'no', 'names']));
        allow delete: if isOwner(g) || (signedIn() && meetHost(resource.data) == request.auth.uid);
      }

      // 加入申請（「要批准」模式）：自己申請、自己睇、自己取消；局主睇晒同批核
      match /joinRequests/{uid} {
        allow get: if (signedIn() && request.auth.uid == uid) || can(g, 'approve');
        allow list: if can(g, 'approve');
        allow create: if signedIn() && request.auth.uid == uid
          && request.resource.data.inviteCode == groupDoc(g).data.inviteCode
          && joinMode(g) == 'approve'
          && photoOk(request.resource.data)
          && request.resource.data.keys().hasOnly(['name', 'photoURL', 'inviteCode', 'at']);
        allow update: if false;
        allow delete: if can(g, 'approve') || (signedIn() && request.auth.uid == uid);
      }

      // 大局同枱
      match /sessions/{s} {
        function paidOk() {
          let key = request.resource.data.get('lastPaid', '');
          let changed = request.resource.data.get('paid', {}).diff(resource.data.get('paid', {})).affectedKeys();
          return isOwner(g) || resource.data.createdBy == request.auth.uid
            || (key is string && changed.hasOnly([key])
              && key.matches('(.*[^A-Za-z0-9])?' + request.auth.uid + '([^A-Za-z0-9].*)?'));
        }
        // 一定要收錢嘅人確認：俾錢嘅人淨係標得「等確認」（ok == false）；收錢嘅人、局主、場主先可以標搞掂
        function paidConfirmOk() {
          let key = request.resource.data.get('lastPaid', '');
          let v = request.resource.data.get('paid', {}).get(key, null);
          return v == null || v.get('ok', true) == false
            || isOwner(g) || resource.data.createdBy == request.auth.uid
            || (key is string && key.split('>').size() == 2
              && key.split('>')[1].matches('(.*[^A-Za-z0-9])?' + request.auth.uid + '([^A-Za-z0-9].*)?'));
        }
        allow read: if isMember(g);
        // 匯入嘅舊紀錄（legacy）淨係局主／超級管理員寫得
        allow create: if isMember(g) && (!('legacy' in request.resource.data) || isOwner(g));
        // 家規、舊紀錄、水由誰保管：淨係局主改得
        allow update: if isMember(g)
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['legacy']) || isOwner(g))
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['rules', 'rulesLog', 'waterTo']) || can(g, 'rules'))
          // 已埋數：今日人物唔可以再改（局主除外）
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['people', 'skipTeams']) || resource.data.get('closed', null) == null || can(g, 'records'))
          // 已轉／未轉：局主、場主改得晒；其他人淨係改到自己份（俾錢或者收錢嗰邊有自己）
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['paid', 'lastPaid']) || (paidOk() && paidConfirmOk()))
          // 直播室禁言：場主、局主（同超級管理員）先改得
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['chatBlock']) || isOwner(g) || resource.data.createdBy == request.auth.uid)
          // 夠拉通知：淨係局主、場主（同超級管理員）揀得
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['pullPush']) || isOwner(g) || resource.data.createdBy == request.auth.uid);
        allow delete: if can(g, 'records');

        // 直播室留言：同圈成員睇同留；自己或者局主刪。
        // 防洗版：每次留言要同時更新 chatLast/{自己}，同上一次相隔最少 2 秒；被禁言（未到時間）就唔准
        match /chat/{c} {
          function lastPath() {
            return /databases/$(database)/documents/groups/$(g)/sessions/$(s)/chatLast/$(request.auth.uid);
          }
          function notBlocked() {
            let b = get(/databases/$(database)/documents/groups/$(g)/sessions/$(s)).data.get('chatBlock', {});
            return !(request.auth.uid in b) || b[request.auth.uid] < request.time.toMillis();
          }
          allow read: if isMember(g);
          allow create: if isMember(g) && request.resource.data.by == request.auth.uid
            && request.resource.data.text is string && request.resource.data.text.size() <= 200
            && notBlocked()
            && getAfter(lastPath()).data.at == request.time
            && (!exists(lastPath()) || get(lastPath()).data.at < request.time - duration.value(2, 's'));
          allow update: if false;
          allow delete: if isOwner(g) || (signedIn() && resource.data.by == request.auth.uid);
        }

        match /chatLast/{u} {
          allow read: if isMember(g);
          allow create, update: if isMember(g) && request.auth.uid == u && request.resource.data.keys().hasOnly(['at']) && request.resource.data.at == request.time;
        }

        // 換人請求：同局成員都睇到、發到、答到
        match /requests/{r} {
          allow read, create, update: if isMember(g);
          allow delete: if isOwner(g);
        }

        // 埋數：開支同 Group，同局成員都可以加、改、刪；已埋數就鎖定（局主除外）
        match /expenses/{x} {
          allow read: if isMember(g);
          allow create, update, delete: if isMember(g) && (isOpen(g, s) || can(g, 'records'));
        }
        match /pairs/{x} {
          allow read: if isMember(g);
          allow create, update, delete: if isMember(g) && (isOpen(g, s) || can(g, 'records'));
        }

        match /tables/{t} {
          function tablePath(id) {
            return /databases/$(database)/documents/groups/$(g)/sessions/$(s)/tables/$(id);
          }
          // 坐喺呢張枱：新枱睇 liveUsers（而家坐喺度、有帳戶嘅人）；舊枱冇 liveUsers 就睇 names（坐過嘅人）
          function seatedAt(d) {
            return d.get('liveUsers', null) != null ? request.auth.uid in d.liveUsers : request.auth.uid in d.names;
          }
          function hostOrOwner() {
            return isOwner(g) || get(/databases/$(database)/documents/groups/$(g)/sessions/$(s)).data.createdBy == request.auth.uid;
          }
          // 可以入數、擲骰：坐喺度嘅人；成枱都係訪客就由場主或者局主幫手（超級管理員一律可以，見最頂）
          function canPlay(d) {
            return seatedAt(d) || (d.get('liveUsers', null) != null && d.liveUsers.size() == 0 && hostOrOwner());
          }
          // 接受換人邀請：請求要係俾自己、喺呢張枱、未答
          function viaRequest(rid) {
            let r = get(/databases/$(database)/documents/groups/$(g)/sessions/$(s)/requests/$(rid)).data;
            return r['in'] == request.auth.uid && r.tableId == t && r.status == 'pending';
          }
          // 由隔籬枱對調：要坐喺嗰張枱
          function viaPair(pid) {
            return pid is string && pid != '' && pid != t && seatedAt(get(tablePath(pid)).data);
          }

          allow read: if isMember(g);
          // 座位、擲骰、坐喺度嘅人：淨係坐喺度嘅人改得；換人邀請、隔籬枱對調、舊枱補資料例外
          allow update: if isMember(g) && (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['dice', 'seats', 'liveUsers', 'names', 'lastReq', 'lastPair', 'waitRegroup', 'waitAt'])
            || canPlay(resource.data)
            || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['names', 'liveUsers', 'lastReq'])
              && request.resource.data.get('lastReq', '') is string && request.resource.data.get('lastReq', '') != ''
              && viaRequest(request.resource.data.lastReq))
            || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['names', 'liveUsers', 'lastPair'])
              && viaPair(request.resource.data.get('lastPair', '')))
            || (resource.data.get('liveUsers', null) == null
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['liveUsers'])
              && request.resource.data.liveUsers.hasOnly(resource.data.names.keys())
              && (request.auth.uid in resource.data.names || hostOrOwner()))
          );
          // 已埋數唔可以再開枱（局主除外）
          allow create: if isMember(g) && (isOpen(g, s) || isOwner(g));
          allow delete: if can(g, 'records');

          // 每一鋪：只可以加，唔可以改或者刪。
          // 文件 id = 序號；同一個序號第二個人寫會變成「改」，會被拒絕，
          // 所以兩個人同時入數只會有一個成功。撤回 = 加一條「撤回」事件。
          match /events/{e} {
            allow read: if isMember(g);
            // 只有坐喺呢張枱嘅人先入到數；「完場」（埋數、一齊執位時）全部成員都可以；
            // 換人：接受邀請嘅人、或者由隔籬枱對調訪客過嚟
            allow create: if isMember(g) && request.resource.data.by == request.auth.uid
              && request.resource.data.seq is int
              && (request.resource.data.event.type == 'end'
                || canPlay(get(tablePath(t)).data)
                || (request.resource.data.event.type == 'swap'
                  && request.resource.data.event['in'] == request.auth.uid
                  && request.resource.data.get('req', '') is string && request.resource.data.get('req', '') != ''
                  && viaRequest(request.resource.data.req))
                || (request.resource.data.event.type == 'swap'
                  && request.resource.data.event.out.matches('guest-.*')
                  && viaPair(request.resource.data.get('pair', ''))));
            allow update: if false;
            // 只有刪除成個大局／枱時，局主先可以清走
            allow delete: if isOwner(g);
          }
        }
      }
    }
  }
}
