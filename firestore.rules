rules_version = '2';

// 雀簿資料庫規則：預設乜都唔准，只開放牌友圈成員需要嘅讀寫。
// 網頁設定（apiKey 嗰啲）係公開嘅，真正保護資料嘅係呢份規則。
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function groupDoc(g) {
      return get(/databases/$(database)/documents/groups/$(g));
    }
    function isMember(g) {
      return signedIn() && exists(/databases/$(database)/documents/groups/$(g)/members/$(request.auth.uid));
    }
    function isOwner(g) {
      return signedIn() && groupDoc(g).data.ownerId == request.auth.uid;
    }

    // 玩家資料：登入咗就睇到名同頭像；淨係自己改到自己
    match /users/{uid} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'photoURL', 'updatedAt', 'groups']);
      allow delete: if false;
    }

    // 牌友圈
    match /groups/{g} {
      allow read: if isMember(g);
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isOwner(g);
      allow delete: if false;

      // 成員：自己用邀請碼加入，或者由局主加
      match /members/{uid} {
        allow read: if isMember(g) || (signedIn() && request.auth.uid == uid);
        allow create: if signedIn() && request.auth.uid == uid
          && (isOwner(g) || request.resource.data.inviteCode == groupDoc(g).data.inviteCode);
        // 自己改自己個名同頭像，唔可以改邀請碼
        allow update: if signedIn() && request.auth.uid == uid
          && request.resource.data.inviteCode == resource.data.inviteCode;
        allow delete: if isOwner(g) || (signedIn() && request.auth.uid == uid);
      }

      // 大局同枱
      match /sessions/{s} {
        allow read, create: if isMember(g);
        // 家規淨係局主改得
        allow update: if isMember(g)
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['rules']) || isOwner(g));
        allow delete: if isOwner(g);

        // 換人請求：同局成員都睇到、發到、答到
        match /requests/{r} {
          allow read, create, update: if isMember(g);
          allow delete: if false;
        }

        // 埋數：開支同 GP，同局成員都可以加、改、刪
        match /expenses/{x} {
          allow read, create, update, delete: if isMember(g);
        }
        match /pairs/{x} {
          allow read, create, update, delete: if isMember(g);
        }

        match /tables/{t} {
          allow read, create, update: if isMember(g);
          allow delete: if isOwner(g);

          // 每一鋪：只可以加，唔可以改或者刪。
          // 文件 id = 序號；同一個序號第二個人寫會變成「改」，會被拒絕，
          // 所以兩個人同時入數只會有一個成功。撤回 = 加一條「撤回」事件。
          match /events/{e} {
            allow read: if isMember(g);
            allow create: if isMember(g) && request.resource.data.by == request.auth.uid
              && request.resource.data.seq is int;
            allow update, delete: if false;
          }
        }
      }
    }
  }
}
